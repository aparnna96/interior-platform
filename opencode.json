{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "msedge",
        "--isolated",
        "--viewport-size",
        "1440x900",
        "--output-dir",
        ".playwright-output"
      ],
      "enabled": true
    }
  }
}
